# -------------------------------------------------------------
# LLM Provider Configuration (Optional - Defaults to local Mock Engine)
# Supported LLM_PROVIDER values: mock (default), openai
# For local OpenAI-compatible backends (e.g. Ollama, vLLM, LocalAI), set:
# LLM_PROVIDER=openai
# LLM_API_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3
# -------------------------------------------------------------
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=demo-gpt-4o
LLM_API_BASE_URL=https://api.openai.com/v1

# -------------------------------------------------------------
# Prompt Security Gateway Authentication (Optional)
# When set, callers to /api/v1/chat/completions must provide:
# Authorization: Bearer <GATEWAY_API_KEY>
# If empty, gateway runs in permissive local development mode.
# -------------------------------------------------------------
GATEWAY_API_KEY=

# -------------------------------------------------------------
# Email Alert Configuration (SMTP)
# To receive real emails in Gmail:
# 1. Set SMTP_HOST=smtp.gmail.com
# 2. Set SMTP_PORT=587
# 3. Set SMTP_USER=your_email@gmail.com
# 4. Set SMTP_PASSWORD=your_16_char_google_app_password
# 5. Set ALERT_EMAIL_RECIPIENT=your_email@gmail.com
# -------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_RECIPIENT=security-admin@enterprise.local

# -------------------------------------------------------------
# SMS Alert Configuration (Twilio - Optional)
# -------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
ALERT_PHONE_NUMBER=+91-XXXXXXXXXX
